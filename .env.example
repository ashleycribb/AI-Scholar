# API Keys
# Server-side only. Never prefix with VITE_ (that would ship it to the browser).
GEMINI_API_KEY=
# Optional Gemini proxy tuning
# GEMINI_PROXY_PER_CLIENT_PER_MIN=60
# GEMINI_PROXY_GLOBAL_PER_MIN=600
# GEMINI_PROXY_ALLOWED_ORIGINS=chrome-extension://<extension-id>
OPENALEX_API_KEY=
SERPAPI_KEY=
SEMANTIC_SCHOLAR_API_KEY=

# Production scholarly API identity
SCHOLAR_CONTACT_EMAIL=
SCHOLAR_SERVICE_NAME=ScholarExplorer

# Optional S3A LRS Configuration
# Defaults to hosted https://34.74.163.88.sslip.io/xapi
VITE_LRS_ENDPOINT=
VITE_EXPLORER_LRS_USERNAME=explorer
VITE_EXPLORER_LRS_PASSWORD=
VITE_RESEARCHER_LRS_USERNAME=researcher
VITE_RESEARCHER_LRS_PASSWORD=
