# API Keys
# Server-side only. Never prefix with VITE_ (that would ship it to the browser).
GEMINI_API_KEY=
# Optional Gemini proxy tuning
# GEMINI_PROXY_PER_CLIENT_PER_MIN=60
# GEMINI_PROXY_GLOBAL_PER_MIN=600
# GEMINI_PROXY_ALLOWED_ORIGINS=chrome-extension://<extension-id>
# Search-result scoring (POST /api/embed). Default: a local open model on this server, no Gemini quota.
# EMBED_PROVIDER=local            # or gemini (gemini-embedding-2-preview via the server key; spends quota)
# EMBED_LOCAL_MODEL=BAAI/bge-small-en-v1.5
# EMBED_LOCAL_DTYPE=fp32
# EMBED_MODEL_CACHE_DIR=          # where the ~130 MB model is downloaded/kept; bake it into the image to skip the cold-start download
# EMBED_WARMUP=1                  # load the model at server start (0 = on first request)
# EMBED_PER_CLIENT_PER_MIN=120
OPENALEX_API_KEY=
SERPAPI_KEY=
SEMANTIC_SCHOLAR_API_KEY=

# Production scholarly API identity
SCHOLAR_CONTACT_EMAIL=
SCHOLAR_SERVICE_NAME=ScholarExplorer

# Optional S3A LRS Configuration
# Defaults to hosted https://34.74.163.88.sslip.io/xapi
VITE_LRS_ENDPOINT=
VITE_EXPLORER_LRS_USERNAME=explorer
VITE_EXPLORER_LRS_PASSWORD=
VITE_RESEARCHER_LRS_USERNAME=researcher
VITE_RESEARCHER_LRS_PASSWORD=
