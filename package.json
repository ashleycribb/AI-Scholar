{
  "name": "ai-research-explorer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node dist/server.cjs",
    "build": "vite build && esbuild server.ts --bundle --platform=node --target=node18 --packages=external --outfile=dist/server.cjs && esbuild scripts/data-backup.ts --bundle --platform=node --target=node18 --packages=external --outfile=dist/data-backup.cjs",
    "build-extension": "vite build -c vite.extension.config.ts && node copy-extension-assets.js",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "bun test",
    "data:backup": "tsx scripts/data-backup.ts backup",
    "data:verify": "tsx scripts/data-backup.ts verify",
    "data:restore": "tsx scripts/data-backup.ts restore",
    "check:no-cdn": "node scripts/check-no-cdn.mjs dist dist-extension",
    "data:daily": "tsx scripts/data-backup.ts daily"
  },
  "dependencies": {
    "@citation-js/core": "0.7.6",
    "@citation-js/plugin-csl": "0.7.6",
    "@citation-js/plugin-ris": "0.7.6",
    "@google/genai": "^1.19.0",
    "@huggingface/transformers": "^3.8.1",
    "@langchain/core": "^1.1.47",
    "@langchain/google-genai": "^2.1.31",
    "@langchain/openai": "^1.4.6",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "axios": "^1.13.1",
    "body-parser": "^2.2.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "duckdb": "^1.4.4",
    "express": "^5.1.0",
    "fflate": "^0.8.3",
    "jspdf": "2.5.1",
    "langchain": "^1.4.1",
    "lucide-react": "^0.577.0",
    "motion": "^12.38.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^3.5.0",
    "ws": "^8.20.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.33",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@types/node": "^22.14.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.6.2",
    "esbuild": "^0.27.4",
    "fake-indexeddb": "^6.2.8",
    "postcss": "^8.5.33",
    "tailwindcss": "3.4.17",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
