    "body-parser": "^2.2.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "duckdb": "^1.4.4",
    "express": "^5.1.0",
    "langchain": "^1.4.1",
    "lucide-react": "^0.577.0",
    "motion": "^12.38.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^3.5.0",
    "ws": "^8.20.1",
